# treedetect — local data location
# ---------------------------------------------------------------------------
# The input data is NOT stored in the repo; each user supplies their own copy.
# Copy this file to `.env` and point SOFLO_DATA_ROOT at your local data folder:
#
#     cp .env.example .env
#     # then edit SOFLO_DATA_ROOT below
#
# Resolution order used by the pipeline:
#   env SOFLO_DATA_ROOT  >  `data_root:` in config.yaml  >  error.

SOFLO_DATA_ROOT=/path/to/soflo_data

# Expected layout under SOFLO_DATA_ROOT (flat; filenames must match config.yaml `inputs:`):
#
#   soflo_data/
#   ├── umgables_2025_drone_survey_5cm.tif      # orthomosaic — RGB, 5 cm/px, EPSG:32617
#   ├── um_gables_trees.geojson                 # botanical inventory points (ground truth)
#   ├── um_gables_tree_segmentation.geojson     # prior-model crown polygons (reference)
#   ├── um_gables_tree_detection.geojson        # prior-model boxes (reference only)
#   └── GDSC_metadata(Metadata).csv             # GDSC tile metadata catalog
#
# Steps s03–s06 need only the orthomosaic; s01–s02 (label building) also need
# the three geojsons. Output figures/artifacts are written inside the repo
# (outputs/ and reports/), never under SOFLO_DATA_ROOT.
